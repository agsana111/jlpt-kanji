 "ruby": {
  "j1512070": "正方形[せいほうけい]には四[よっ]つの辺[へん]がある。",
  "j1216250": "今日[きょう]から丸[まる]１日[にち]お願[ねが]いします。",
  "j1240530": "彼[かれ]の額[ひたい]には玉[たま]のような汗[あせ]が浮[う]かんでいた。",
  "j1497190": "日曜日[にちようび]は私[わたし]にとって普通[ふつう]の日[ひ]ではない。",
  "j1249470": "その傾向[けいこう]はアメリカ人[じん]に強[つよ]いようですね。",
  "j1490430": "私[わたし]の時計[とけい]は１日[にち]に５秒[びょう]進[すす]みます。",
  "j1233010": "彼[かれ]らは漁師[りょうし]に変装[へんそう]し船[ふね]に乗[の]って逃[に]げた。",
  "j1516160": "富[とみ]は一生[いっしょう]の宝[たから]、知[ち]は万代[ばんだい]の宝[たから]。",
  "j1255120": "赤十字[せきじゅうじ]は病院[びょういん]に血液[けつえき]を供給[きょうきゅう]した。",
  "j1603510": "洗濯物[せんたくもの]を干[ほ]すには最高[さいこう]の天気[てんき]だ。",
  "j1213060": "額[ひたい]の汗[あせ]をふきなさい。",
  "j1234140": "十中八九[じっちゅうはっく]、彼[かれ]が競争[きょうそう]に勝[か]つでしょう。",
  "j1176510": "宿泊[しゅくはく]をもう一晩[ひとばん]延長[えんちょう]できますか。",
  "j1200840": "改札口[かいさつぐち]で切符[きっぷ]をお見[み]せください。",
  "j1200060": "今日[きょう]は快晴[かいせい]だ。これで一日中[いちにちじゅう]仕事[しごと]が出来[でき]る。",
  "j1295310": "今度[こんど]の祭日[さいじつ]は日曜日[にちようび]と重[かさ]なります。",
  "j1956150": "漢字[かんじ]の読[よ]み方[かた]には、音[おん]と訓[くん]の2通[とお]りがあるの。",
  "j1234210": "ダービー競馬[けいば]の日[ひ]は２週間[しゅうかん]後[ご]の水曜日[すいようび]だ。",
  "j1223820": "６時[じ]起床[きしょう]、７時[じ]家[いえ]を出[で]る。",
  "j1331300": "ケイトのお父[とう]さんは家[いえ]の周辺[しゅうへん]にいる。",
  "j1307090": "箱[はこ]の形[かたち]は普通[ふつう]四角[しかく]です。",
  "j1290360": "三原色[さんげんしょく]を混合[こんごう]すると黒色[くろいろ]ができる。",
  "j1474860": "一晩[ひとばん]彼[かれ]を泊[と]めることができる。",
  "j2167510": "お姉[ねえ]さんのことはたいへんお気[き]の毒[どく]に思[おも]います。",
  "j1209630": "洗濯物[せんたくもの]を乾[かわ]かす時間[じかん]だ。"
 },
