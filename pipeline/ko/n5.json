 "ruby": {
  "j1476920": "日本[にほん]では、八月[はちがつ]八日[ようか]はヒゲの日[ひ]です。",
  "j1580640": "あの人[ひと]たちはロシア人[じん]です。",
  "j1269060": "午前中[ごぜんちゅう]はずっと本[ほん]を読[よ]んでました。",
  "j1578150": "十中八九[じっちゅうはっく]ジェーンは来[く]るだろう。",
  "j1583090": "八時[はちじ]にお前[まえ]んとこに行[い]くから。",
  "j1585310": "六時[ろくじ]きっかりにここへ来[き]なさい。",
  "j1319210": "「今日[きょう]って、何日[なんにち]？」「七月[しちがつ]七日[なのか]よ」",
  "j1388740": "千人[せんにん]もの人[ひと]がそこにいた。"
 },
 "sentences": {
  "j1160790": null,
  "j1579110": "오늘은 뭘 하고 싶어요?",
  "j1301330": "2~3일 안에 전화할게.",
  "j1476920": "일본에서는 8월 8일이 수염의 날입니다.",
  "j1576260": "하루에 몇 시간 TV를 봐요?",
  "j2225040": null,
  "j1268570": "3일에서 5일 정도로.",
  "j1160820": "하나를 취소했습니다.",
  "j1576200": "평생 다시는 이런 짓 안 할게요.",
  "j1592250": "어느 나라에서 태어났어요?",
  "j1203620": "언젠가 외국에 가 보고 싶다.",
  "j1366770": "하지만 인간은 다르다.",
  "j1540150": "앤에게는 친구가 많이 있다.",
  "j1468060": "나이를 여쭤봐도 될까요?",
  "j1579130": "이게 올해 카탈로그입니다.",
  "j1548220": "내년에도 또 여기 오고 싶다.",
  "j1413240": "모두 이 대학 학생입니다.",
  "j1412890": "정말 큰 호박이다!",
  "j1588880": "이 TV, 크고 비싸.",
  "j1579840": "일본에 온 지 10년이 됩니다.",
  "j1461140": "2시 반까지는 그걸 하고 싶지 않아.",
  "j1429750": "빌하고는 오랫동안 못 만났다.",
  "j1279590": "교장 선생님이 선생님 뒤에서 들어왔다.",
  "j1338180": "삼촌은 선뜻 돈을 낸다.",
  "j1338240": "언제쯤 나올까.",
  "j1598550": "언제 파티에 나가?",
  "j1579350": "이 나라에는 3년 전에 왔어.",
  "j1299740": "커피 세 잔 부탁합니다.",
  "j1315920": "독서할 시간은 언제든 낼 수 있다.",
  "j1598680": "가끔 톰이랑 같이 그걸 한다.",
  "j1259290": "TV 보는 거 그만두자.",
  "j1547900": "다음 달에 혼자 일본에 갑니다.",
  "j1387500": "지난달에 독감에 걸렸다.",
  "j1289100": "이번 달 말까지 여기 있습니다.",
  "j1584350": "매달 책을 얼마나 읽어요?",
  "j1269320": "대단하다! 나중에 봐야지.",
  "j1268990": "오늘 오후에는 시간이 없어.",
  "j1269410": "뒷문이 찌그러졌다.",
  "j1392580": "똑바로 앞을 봐 주세요.",
  "j1531710": "당신 이름은 명단에서 빠졌다.",
  "j1378690": "도토리에서 참나무가 생겨난다.",
  "j1215230": "두 사람 사이가 잘 맞지 않는다.",
  "j1352130": "벽난로 선반 위에 있어.",
  "j1352320": null,
  "j1352570": "달은 동쪽에서 뜬다.",
  "j1447440": "일본은 동아시아에 있습니다.",
  "j1288850": "방금 안내 방송은 뭐였어요?",
  "j1578150": "십중팔구 제인은 올 거야.",
  "j1465590": "이 맥주잔에는 1파인트가 들어간다.",
  "j1465610": "커피에 크림 넣을래?",
  "j1347870": "여기에는 원래 초등학교가 있었다.",
  "j1283190": "이 TV, 크고 비싸.",
  "j1283500": "고등학교, 엄청 큰 학교였어?",
  "j1175570": "5,000엔 정도 가지고 있다.",
  "j1420010": "저 잘생긴 남자아이 좀 봐.",
  "j1583090": "8시에 너네 집에 갈게.",
  "j1585310": "6시 정각에 여기로 와.",
  "j1184140": "열쇠는 매트 밑에 있습니다.",
  "j1438690": "오늘 날씨가 맑으면 좋을 텐데.",
  "j1443000": "이 에어컨은 전기를 많이 먹네.",
  "j1347750": "이 책은 정말 작구나.",
  "j1319210": "\"오늘 며칠이야?\" \"7월 7일이야.\"",
  "j1302680": "해야 할 일이 산더미야.",
  "j1600900": "이야기 좀 들려줘.",
  "j1562350": "너한테 할 말은 없어.",
  "j1344930": "사람은 남자 아니면 여자다.",
  "j1520670": "북쪽이 어느 쪽이야?",
  "j1488000": "100센트는 1달러가 됩니다.",
  "j1343950": "읽지도 쓰지도 못한다.",
  "j1387210": "그다음 이야기를 듣고 싶어.",
  "j1390020": "톰은 뗏목으로 강을 내려갔다.",
  "j1388740": "천 명이나 되는 사람이 거기 있었다.",
  "j1371260": "물을 틀어 놓은 채로 두지 마.",
  "j1478750": "그건 3년 반 전 일이었습니다.",
  "j1419990": "정말 남자답지 않네.",
  "j1380840": "프랑스는 서유럽에 있다.",
  "j1443530": "전철로 왔어요.",
  "j1270910": "멕시코에서는 무슨 말을 하나요?",
  "j1445270": "그는 흙에 물을 주었다.",
  "j1534520": "차가 쿵 하고 나무에 부딪혔다.",
  "j1591110": "톰은 이것에 대해 물어봐야 한다.",
  "j1591150": "\"들려?\" \"응, 들려.\"",
  "j2846738": "학교 앞에 나무가 몇 그루 보입니다.",
  "j1459870": "남쪽 터미널은 어디예요?",
  "j1584460": "그건 1만 엔 정도 할 거야.",
  "j1193610": "이 라이터는 불이 안 켜진다.",
  "j1171010": "일본 차는 핸들이 오른쪽입니다.",
  "j1456360": "읽기 싫으면 읽지 마.",
  "j1539980": "책은 친구에 비유할 수 있다.",
  "j1290800": "왼쪽 수건이 네 거야.",
  "j1227560": "톰은 자주 학교를 쉰다."
 }
