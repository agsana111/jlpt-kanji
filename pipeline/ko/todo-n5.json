 ],
 "sentences": [
  {
   "id": "j1160790",
   "ja": "一、二、三、四、五。",
   "en": null,
   "ko_tatoeba": "하나, 둘, 셋, 넷, 다섯."
  },
  {
   "id": "j1592250",
   "ja": "どこの国で生まれたんですか？",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1468060",
   "ja": "お年をお聞きしてよろしいでしょうか。",
   "en": "Might I ask your age?",
   "ko_tatoeba": null
  },
  {
   "id": "j1579840",
   "ja": "日本に来てから十年になります。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1522150",
   "ja": "本、見つけることができた？",
   "en": null,
   "ko_tatoeba": "책, 찾을 수 있었어?"
  },
  {
   "id": "j1423310",
   "ja": "中にいるの？",
   "en": null,
   "ko_tatoeba": "안에 있어?"
  },
  {
   "id": "j1429750",
   "ja": "ビルには長い間あっていない。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1338180",
   "ja": "おじは気前よく金を出す。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1579350",
   "ja": "この国には、三年前に来たんだ。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1578850",
   "ja": "アメリカへ行く時間がない。",
   "en": null,
   "ko_tatoeba": "나는 미국에 갈 시간이 없다."
  },
  {
   "id": "j1259290",
   "ja": "テレビを見るのやめましょう。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1269320",
   "ja": "すごいね！後で見てみよっと。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1392580",
   "ja": "まっすぐ前を見てください。",
   "en": "Look forward, please.",
   "ko_tatoeba": null
  },
  {
   "id": "j1268060",
   "ja": "五ヶ国語話します。",
   "en": null,
   "ko_tatoeba": "저는 다섯 개의 언어를 합니다."
  },
  {
   "id": "j1315920",
   "ja": "いつだって読書の時間は見つけられる。",
   "en": "We can always find time for reading.",
   "ko_tatoeba": null
  },
  {
   "id": "j1352130",
   "ja": "マントルピースの上にあるよ。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1447440",
   "ja": "日本は東アジアにあります。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1579110",
   "ja": "今日は何をしたいですか。",
   "en": "What would you like to do today?",
   "ko_tatoeba": null
  },
  {
   "id": "j1001820",
   "ja": "いくらお金をもっていますか。",
   "en": null,
   "ko_tatoeba": "돈을 얼마나 가지고 계세요?"
  },
  {
   "id": "j1578150",
   "ja": "十中八九ジェーンは来るだろう。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1465590",
   "ja": "このジョッキは１パイント入る。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1413240",
   "ja": "みんな、この大学の学生です。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1283190",
   "ja": "このテレビ、大きいし高いよ。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1175570",
   "ja": "５０００円ばかりもっている。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1583090",
   "ja": "八時にお前んとこに行くから。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1585310",
   "ja": "六時きっかりにここへ来なさい。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1184140",
   "ja": "キーはマットの下にあります。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1547900",
   "ja": "来月一人で日本に行きます。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j2136180",
   "ja": "「どうかしたの？」と小さな白いウサギが聞きました。",
   "en": null,
   "ko_tatoeba": "작고 흰 토끼는 \"무슨 일 있니?\" 라고 물어봤습니다."
  },
  {
   "id": "j1319210",
   "ja": "「今日って、何日？」「七月七日よ」",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1302680",
   "ja": "やるべきことは山ほどあるぞ。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1600900",
   "ja": "話を聞かせてくれ。",
   "en": "I want a full report though.",
   "ko_tatoeba": null
  },
  {
   "id": "j1344970",
   "ja": "トムさんはビキニの女の子を見ていた。",
   "en": null,
   "ko_tatoeba": "톰 씨는 비키니를 입은 여자 아이를 보고 있었다."
  },
  {
   "id": "j1520670",
   "ja": "北って、どっち？",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1488000",
   "ja": "百セントは一ドルになります。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1343950",
   "ja": "読むことも書くこともできない。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1387990",
   "ja": "先生、こんにちは。",
   "en": null,
   "ko_tatoeba": "선생님, 안녕하세요."
  },
  {
   "id": "j1390020",
   "ja": "トムは、いかだで川を下った。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1388740",
   "ja": "千人もの人がそこにいた。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1371260",
   "ja": "水を出しっぱなしにしないで。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1478750",
   "ja": "それは３年半前のことでした。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1419990",
   "ja": "ほんとうに男らしくないよね。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1380840",
   "ja": "フランスは西ヨーロッパにある。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1270910",
   "ja": "メキシコではなに語を話すのですか。",
   "en": "What is the language spoken in Mexico?",
   "ko_tatoeba": null
  },
  {
   "id": "j1445270",
   "ja": "かれは土に水をやった。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1534520",
   "ja": "車がどしんと木にぶつかった。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1591110",
   "ja": "トムはこれについて聞くべきだ。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1358280",
   "ja": "ケイトは毎日パンを食べる。",
   "en": null,
   "ko_tatoeba": "케이트는 매일 빵을 먹는다."
  },
  {
   "id": "j1459870",
   "ja": "南ターミナルはどこですか。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1584460",
   "ja": "それは１万円ぐらいするだろう。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1438690",
   "ja": "今日が天気ならいいのに。",
   "en": "I wish it were fine today.",
   "ko_tatoeba": null
  },
  {
   "id": "j1193610",
   "ja": "このライターは火がつかない。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1171010",
   "ja": "日本車は、右ハンドルです。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1456360",
   "ja": "読みたくないんなら、読むな。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1539980",
   "ja": "本は友になぞらえることが出来る。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1290800",
   "ja": "左のタオルが、あなたのよ。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1227500",
   "ja": "もし半年休みがあったら何する？",
   "en": null,
   "ko_tatoeba": "만약 반년동안 휴일이 있다면 뭐할래?"
  },
  {
   "id": "j1171900",
   "ja": "「雨やんだかな？」「やんでるといいね」",
   "en": null,
   "ko_tatoeba": "\"비가 그친 걸까?\" \"그치면 좋겠네.\""
  },
  {
   "id": "j1576150",
   "ja": "それはあなたが一人になりたくないからです。",
   "en": null,
   "ko_tatoeba": "왜냐하면 당신은 혼자가 되고 싶지 않기 때문이에요."
  },
  {
   "id": "j1580640",
   "ja": "あの人たちはロシア人です。",
   "en": null,
   "ko_tatoeba": "저 사람들은 러시아 사람입니다."
  },
  {
   "id": "j1412890",
   "ja": "なんて大きなかぼちゃなんだ！",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1338240",
   "ja": "いつになったら出るんだろう。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1301330",
   "ja": "二、三日のうちに電話するよ。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1598680",
   "ja": "時々トムとともにそれをする。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1215230",
   "ja": "二人の間がしっくり行かない。",
   "en": "They don't get along together.",
   "ko_tatoeba": null
  },
  {
   "id": "j1352320",
   "ja": "トムはしょっちゅう話をでっ上げるからな。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1579130",
   "ja": "これが今年のカタログです。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1465610",
   "ja": "コーヒーにクリームを入れる？",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1206900",
   "ja": "まだ学生なの？",
   "en": null,
   "ko_tatoeba": "아직 학생이야?"
  },
  {
   "id": "j1307770",
   "ja": "トムっていい子なんだよ。",
   "en": null,
   "ko_tatoeba": "톰은 좋은 아이야."
  },
  {
   "id": "j1203620",
   "ja": "いつか外国へ行きたいものだ。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1203250",
   "ja": "外には出たくない。",
   "en": null,
   "ko_tatoeba": "밖으로는 나가고 싶지 않아."
  },
  {
   "id": "j1221520",
   "ja": "その話聞いたことある気がする。",
   "en": null,
   "ko_tatoeba": "그 이야기 들어본 적이 있는 것 같아."
  },
  {
   "id": "j1347750",
   "ja": "この本は何と小さいのだろう。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1344930",
   "ja": "人は男か女のどちらかである。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1268990",
   "ja": "今日の午後は時間がないんだ。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1387500",
   "ja": "先月インフルエンザにかかった。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1531710",
   "ja": "あなたの名前はリストからはずされた。",
   "en": "Your name was dropped from the list.",
   "ko_tatoeba": null
  },
  {
   "id": "j1420010",
   "ja": "あのハンサムな男の子を見て。",
   "en": "Look at that good-looking boy.",
   "ko_tatoeba": null
  },
  {
   "id": "j1443840",
   "ja": "だれも電話に出ませんでした。",
   "en": null,
   "ko_tatoeba": "아무도 전화를 받지 않았습니다."
  },
  {
   "id": "j1279590",
   "ja": "校長が先生の後ろから入ってきた。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1283500",
   "ja": "高校って、マンモス校だった？",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1591150",
   "ja": "「聞こえる？」「うん。聞こえる」",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1443530",
   "ja": "電車で来たんです。",
   "en": null,
   "ko_tatoeba": "기차를 타고 왔어요."
  },
  {
   "id": "j1323080",
   "ja": "この車は、だれのですか？",
   "en": null,
   "ko_tatoeba": "이 자동차는 누구의 것입니까?"
  },
  {
   "id": "j2846738",
   "ja": "学校の前に何本か木が見えます。",
   "en": "You see some trees in front of the school.",
   "ko_tatoeba": null
  },
  {
   "id": "j1524720",
   "ja": "ケイトは毎日パンを食べる。",
   "en": null,
   "ko_tatoeba": "케이트는 매일 빵을 먹는다."
  },
  {
   "id": "j1584360",
   "ja": "トムって、毎年ボストンに行ってるんだよ。",
   "en": null,
   "ko_tatoeba": "톰은 매년 보스턴에 가요."
  },
  {
   "id": "j1474910",
   "ja": "「どうかしたの？」と小さな白いウサギが聞きました。",
   "en": null,
   "ko_tatoeba": "작고 흰 토끼는 \"무슨 일 있니?\" 라고 물어봤습니다."
  },
  {
   "id": "j1540150",
   "ja": "アンには友人がたくさんいる。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1227560",
   "ja": "トムはよく学校を休む。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1463770",
   "ja": "今日は学校に行かない日だ。",
   "en": null,
   "ko_tatoeba": "오늘은 학교에 가지 않는 날이다."
  },
  {
   "id": "j1160820",
   "ja": "一つをキャンセルしました。",
   "en": null,
   "ko_tatoeba": "하나를 취소했습니다"
  },
  {
   "id": "j1414170",
   "ja": "大人げないことしなきゃいいのに。",
   "en": null,
   "ko_tatoeba": "유치한 짓 하지 않으면 좋을 텐데."
  },
  {
   "id": "j1582670",
   "ja": "二人ともこんなところで何してるの？",
   "en": null,
   "ko_tatoeba": "너희 둘 다 이런 곳에서 뭐하는 거야?"
  },
  {
   "id": "j1461140",
   "ja": "二時半までそれをしたくない。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1255430",
   "ja": "天に月がある。",
   "en": null,
   "ko_tatoeba": "하늘에 달이 있다."
  },
  {
   "id": "j1269410",
   "ja": "後ろのドアにへこみができた。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1576200",
   "ja": "もう一生こんなことはしません。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1366770",
   "ja": "しかし、人間はちがっている。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1352570",
   "ja": "月は東から上る。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1288850",
   "ja": "今のアナウンスは何だったのですか。",
   "en": "What did the announcement just say?",
   "ko_tatoeba": null
  },
  {
   "id": "j1476920",
   "ja": "日本では、八月八日はヒゲの日です。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1548220",
   "ja": "来年もまたここに来たいな。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1547720",
   "ja": "ここよく来るの？",
   "en": null,
   "ko_tatoeba": "여기 자주 와?"
  },
  {
   "id": "j1562350",
   "ja": "お前なんかに話すことはない。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1269060",
   "ja": "午前中はずっと本を読んでました。",
   "en": null,
   "ko_tatoeba": "오전 중에는 쭉 책을 읽고 있었습니다."
  },
  {
   "id": "j1387210",
   "ja": "それから先の話を聞きたい。",
   "en": "I'd like to know the rest of the story.",
   "ko_tatoeba": null
  },
  {
   "id": "j1347870",
   "ja": "ここにもとは小学校があった。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1576260",
   "ja": "一日何時間テレビを見ますか？",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j2225040",
   "ja": "ローマは一日にしてならず。",
   "en": null,
   "ko_tatoeba": null
  },
  {
   "id": "j1588880",
